{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Selection",
  "type": "object",
  "required": [
    "schema_version",
    "selectedAt",
    "winner",
    "evaluated"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "selectedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "winner": {
      "type": [
        "object",
        "null"
      ]
    },
    "runnersUp": {
      "type": "array"
    },
    "evaluated": {
      "type": "array",
      "minItems": 1
    },
    "discoveryFailures": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
