{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Delivery package",
  "type": "object",
  "required": [
    "schema_version",
    "videoFile",
    "thumbnailFile",
    "title",
    "description",
    "tags",
    "chapters",
    "sourcesListed",
    "disclaimerIncluded",
    "published",
    "qaVerdict"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "videoFile": {
      "type": "string"
    },
    "thumbnailFile": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 50
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "time",
          "title"
        ],
        "properties": {
          "time": {
            "type": "string",
            "pattern": "^\\d{1,2}:\\d{2}$"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "sourcesListed": {
      "const": true
    },
    "disclaimerIncluded": {
      "const": true
    },
    "published": {
      "const": false
    },
    "qaVerdict": {
      "const": "pass"
    }
  },
  "additionalProperties": true
}
