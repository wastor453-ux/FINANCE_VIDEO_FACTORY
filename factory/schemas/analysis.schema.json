{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source analysis",
  "type": "object",
  "required": [
    "schema_version",
    "videoId",
    "coreTopic",
    "viewerPromise",
    "hook",
    "structure",
    "corePoints",
    "improvementPlan"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "videoId": {
      "type": "string"
    },
    "coreTopic": {
      "type": "string",
      "minLength": 5
    },
    "viewerPromise": {
      "type": "string",
      "minLength": 5
    },
    "hook": {
      "type": "object",
      "required": [
        "technique",
        "firstSeconds"
      ],
      "properties": {
        "technique": {
          "type": "string"
        },
        "firstSeconds": {
          "type": "string"
        }
      }
    },
    "structure": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "beat",
          "purpose"
        ],
        "properties": {
          "beat": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "approxShare": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "corePoints": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "claimsToVerify": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "improvementPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "motionFit": {
      "type": "object",
      "required": [
        "share",
        "beats"
      ],
      "properties": {
        "share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "beat",
              "mode"
            ],
            "properties": {
              "beat": {
                "type": "string"
              },
              "mode": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "beliefShift": {
      "type": "object",
      "required": [
        "fromBelief",
        "toBelief"
      ],
      "properties": {
        "fromBelief": {
          "type": "string"
        },
        "toBelief": {
          "type": "string"
        }
      },
      "description": "What the viewer wrongly believes at second 0 and what the source shows them by the end (research only; our script makes its own case)."
    },
    "curiosityLoops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "resolvedAt"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "resolvedAt": {
            "type": "string"
          }
        }
      },
      "description": "Questions planted early and answered later; they keep viewers watching."
    },
    "friction": {
      "type": "string",
      "description": "The real obstacle, risk or failure rate that makes the topic hard; honest friction builds trust."
    }
  },
  "additionalProperties": true
}
