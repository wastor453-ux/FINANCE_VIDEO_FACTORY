{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source analysis",
  "type": "object",
  "required": [
    "schema_version",
    "videoId",
    "coreTopic",
    "viewerPromise",
    "hook",
    "structure",
    "corePoints",
    "improvementPlan"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "videoId": {
      "type": "string"
    },
    "coreTopic": {
      "type": "string",
      "minLength": 5
    },
    "viewerPromise": {
      "type": "string",
      "minLength": 5
    },
    "hook": {
      "type": "object",
      "required": [
        "technique",
        "firstSeconds"
      ],
      "properties": {
        "technique": {
          "type": "string"
        },
        "firstSeconds": {
          "type": "string"
        }
      }
    },
    "structure": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "beat",
          "purpose"
        ],
        "properties": {
          "beat": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "approxShare": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "corePoints": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "claimsToVerify": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "improvementPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
