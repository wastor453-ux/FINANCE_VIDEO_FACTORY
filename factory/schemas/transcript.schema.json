{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transcript",
  "type": "object",
  "required": [
    "schema_version",
    "videoId",
    "source",
    "language",
    "validated",
    "validation",
    "segments",
    "storage"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "videoId": {
      "type": "string",
      "minLength": 11
    },
    "source": {
      "enum": [
        "youtube_captions",
        "caption_library",
        "yt_dlp_subtitles",
        "audio_transcription",
        "manual"
      ]
    },
    "language": {
      "type": "string"
    },
    "validated": {
      "type": "boolean"
    },
    "validation": {
      "type": "object",
      "required": [
        "matchesVideoDuration",
        "wordCount"
      ],
      "properties": {
        "matchesVideoDuration": {
          "type": "boolean"
        },
        "wordCount": {
          "type": "integer",
          "minimum": 200
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "startMs",
          "endMs",
          "text"
        ],
        "properties": {
          "startMs": {
            "type": "integer",
            "minimum": 0
          },
          "endMs": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "storage": {
      "const": "private_workspace_only"
    }
  },
  "additionalProperties": true
}
