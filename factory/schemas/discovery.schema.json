{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Discovery",
  "type": "object",
  "required": [
    "schema_version",
    "fetchedAt",
    "channels",
    "videos",
    "failures"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "fetchedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "channels": {
      "type": "array",
      "minItems": 1
    },
    "videos": {
      "type": "array",
      "minItems": 1
    },
    "failures": {
      "type": "array"
    },
    "quotaUnitsUsed": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
