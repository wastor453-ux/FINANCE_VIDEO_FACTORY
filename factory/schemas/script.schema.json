{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Script",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "language",
    "targetSeconds",
    "originalityNote",
    "sources",
    "scenes",
    "disclaimerIncluded"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string"
    },
    "language": {
      "const": "en-US"
    },
    "targetSeconds": {
      "type": "integer",
      "minimum": 300,
      "maximum": 1200
    },
    "originalityNote": {
      "type": "string",
      "minLength": 20
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "accessed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "accessed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "beat",
          "narration",
          "claims"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S\\d{2,3}$"
          },
          "beat": {
            "type": "string"
          },
          "narration": {
            "type": "string",
            "minLength": 20
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/claim"
            }
          },
          "beats": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "narration",
                "visualIntent"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "narration": {
                  "type": "string",
                  "minLength": 3
                },
                "visualIntent": {
                  "type": "string"
                },
                "emphasis": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "onScreenText": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "interrupt": {
                  "type": "boolean"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "claimId": {
                      "type": "string"
                    },
                    "values": {
                      "type": "array"
                    }
                  }
                }
              }
            }
          },
          "delivery": {
            "type": "string",
            "description": "Voice register for this scene (a key of config/voice.json request.registers.byId): hook, analysis, conversational, irony, risk, downfall, outro. Omit for the default documentary delivery.",
            "enum": [
              "hook",
              "analysis",
              "conversational",
              "irony",
              "risk",
              "downfall",
              "outro"
            ]
          }
        }
      }
    },
    "disclaimerIncluded": {
      "const": true
    },
    "promises": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "paidOffIn"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "paidOffIn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S\\d{2,3}$"
            }
          }
        }
      }
    },
    "hookType": {
      "enum": [
        "curiosity_gap",
        "stakes",
        "bold_claim",
        "empathy_mirror",
        "specific_promise",
        "in_media_res",
        "pattern_interrupt"
      ]
    },
    "rehookBeat": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "definitions": {
    "claim": {
      "type": "object",
      "required": [
        "id",
        "text",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "verified": {
          "type": "boolean"
        },
        "dataYear": {
          "type": "integer",
          "minimum": 1990,
          "maximum": 2100
        },
        "dataYearNarrated": {
          "type": "boolean"
        },
        "sourceKind": {
          "enum": [
            "primary",
            "secondary",
            "attributed",
            "illustrative"
          ]
        },
        "sourceQuote": {
          "type": "string"
        }
      }
    }
  }
}
