{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Script",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "language",
    "targetSeconds",
    "originalityNote",
    "sources",
    "scenes",
    "disclaimerIncluded"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string"
    },
    "language": {
      "const": "en-US"
    },
    "targetSeconds": {
      "type": "integer",
      "minimum": 300,
      "maximum": 1200
    },
    "originalityNote": {
      "type": "string",
      "minLength": 20
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "accessed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "accessed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "beat",
          "narration",
          "claims"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S\\d{2,3}$"
          },
          "beat": {
            "type": "string"
          },
          "narration": {
            "type": "string",
            "minLength": 20
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/claim"
            }
          }
        }
      }
    },
    "disclaimerIncluded": {
      "const": true
    }
  },
  "additionalProperties": true,
  "definitions": {
    "claim": {
      "type": "object",
      "required": [
        "id",
        "text",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "verified": {
          "type": "boolean"
        }
      }
    }
  }
}
