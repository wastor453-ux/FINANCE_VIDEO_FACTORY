{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scene_plan v2 (scenes > beats > typed events)",
  "type": "object",
  "required": [
    "schema_version",
    "fps",
    "width",
    "height",
    "totalFrames",
    "style",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "fps": {
      "const": 30
    },
    "width": {
      "const": 1920
    },
    "height": {
      "const": 1080
    },
    "totalFrames": {
      "type": "integer",
      "minimum": 1
    },
    "style": {
      "type": "object",
      "required": [
        "packId",
        "background"
      ],
      "properties": {
        "packId": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "startFrame",
          "endFrame",
          "beats"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0
          },
          "endFrame": {
            "type": "integer",
            "minimum": 1
          },
          "beats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "startFrame",
                "endFrame",
                "mode",
                "purpose",
                "data",
                "onScreenText",
                "events"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "startFrame": {
                  "type": "integer",
                  "minimum": 0
                },
                "endFrame": {
                  "type": "integer",
                  "minimum": 1
                },
                "mode": {
                  "type": "string",
                  "minLength": 1
                },
                "purpose": {
                  "type": "string",
                  "minLength": 8
                },
                "background": {
                  "type": "string"
                },
                "layout": {
                  "type": "string"
                },
                "transitionIn": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "startFrame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "endFrame": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "additionalProperties": false
                },
                "usesCharacter": {
                  "const": false
                },
                "onScreenText": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/dataPoint"
                  }
                },
                "events": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "recipe",
                      "role",
                      "startFrame",
                      "endFrame",
                      "holdUntilFrame",
                      "ease"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "recipe": {
                        "type": "string",
                        "minLength": 1
                      },
                      "role": {
                        "enum": [
                          "primary",
                          "secondary",
                          "ambient"
                        ]
                      },
                      "startFrame": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "endFrame": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "holdUntilFrame": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "exitFrame": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "ease": {
                        "type": "string"
                      },
                      "anchor": {
                        "type": "object",
                        "required": [
                          "wordIndex",
                          "startMs",
                          "confidence"
                        ],
                        "properties": {
                          "wordIndex": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "word": {
                            "type": "string"
                          },
                          "startMs": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "confidence": {
                            "enum": [
                              "ok",
                              "low",
                              "none"
                            ]
                          },
                          "fallback": {
                            "type": "boolean"
                          }
                        },
                        "additionalProperties": false
                      },
                      "params": {
                        "type": "object",
                        "properties": {
                          "words": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "dataRef": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "dataPoint": {
      "type": "object",
      "required": [
        "label",
        "value",
        "unit"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 3
        },
        "sourceUrl": {
          "type": "string"
        },
        "asOf": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "illustrative": {
          "const": true
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delta": {
          "type": "object",
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            },
            "window": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "series": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "number"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "source",
            "asOf"
          ]
        },
        {
          "required": [
            "illustrative"
          ]
        }
      ]
    }
  }
}